# ══════════════════════════════════════════════════════════════
# AI Pulse — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.
# ══════════════════════════════════════════════════════════════


# ── LLM APIs ──────────────────────────────────────────────────

# Anthropic (Claude Sonnet) — used for analysis layer
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4o) — used for LinkedIn draft generation
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# HuggingFace — optional, raises rate limits on the free Inference API
# Get yours at: https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_...


# ── Twitter / X Scraping ──────────────────────────────────────
# Apify — sign up at https://apify.com/ → API & Integrations → API token
# Actor used: kaitoeasyapi/twitter-x-data-tweet-scraper-pay-per-result-cheapest
# Cost: ~$0.25 per 1000 tweets
APIFY_API_TOKEN=apify_api_...


# ── Email Delivery (SMTP) ─────────────────────────────────────
# Gmail: Settings → Security → 2FA → App Passwords → generate one
# Or use Resend (https://resend.com) free tier
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_TO=your-personal-email@gmail.com


# ── Telegram Bot ──────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Start a chat with your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
TELEGRAM_BOT_TOKEN=123456789:AAF...
TELEGRAM_CHAT_ID=your_chat_id_here

# Webhook — required for 👍/👎 feedback buttons
# Use ngrok (free): ngrok http 8443 → copy the https URL
# Or deploy to Railway/Render and use their permanent URL
# Leave blank to run without feedback buttons (plain Telegram delivery)
TELEGRAM_WEBHOOK_URL=https://your-public-url.ngrok-free.app
WEBHOOK_PORT=8443
